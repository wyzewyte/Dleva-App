# Email Configuration - Brevo (Sendinblue)
# Get your API key from: https://www.brevo.com → Settings → API Keys

# Required: Your Brevo API Key
BREVO_API_KEY=your_brevo_api_key_here

# Optional: Custom sender email
# If not set, defaults to 'noreply@dleva.com'
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Email Configuration for Development
# Set to 'django.core.mail.backends.console.EmailBackend' to see emails in console
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
